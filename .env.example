# Server-side configuration. Never commit populated env files.
HOST=127.0.0.1
PORT=3410
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3410
APP_IMAGE=fulfillment-sentinel-open-supos:local
SUPOS_DOCKER_NETWORK=supos_default_network
SUPOS_BOOTSTRAP_API=http://backend:8080
DEMO_NODERED_URL=http://nodered:1880
DEMO_COMPOSE_PROJECT=
# For write commands, copy these exact values from demo:preflight output.
DEMO_EXPECT_DOCKER_ID=
DEMO_EXPECT_COMPOSE_PROJECT=
DEMO_EXPECT_PLATFORM_URL=
DEMO_EXPECT_MQTT_URL=
DEMO_EXPECT_APP_PORT=
DEMO_ACTION_ACK=
# Set to YES only when intentionally resetting an existing isolated demo case.
DEMO_ALLOW_EXISTING_CASE_RESET=
J2_ARTIFACT_DIR=./artifacts
# Optional manifest stream override
JUDGE_UNS_STREAM=
# Real Runtime: explicitly set the operator's own endpoint. No default remote host.
J2_MQTT_URL=
# CLI verifiers support these credentials; current live product session does not.
J2_MQTT_USERNAME=
J2_MQTT_PASSWORD=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=
AI_JSON_SCHEMA=
